# Workers Static Assets headers (copied into .open-next/assets by the build).
# Next's build files have a content hash in their names, so a URL never changes:
# let browsers keep them for a year without re-checking (#61, per OpenNext's
# Cloudflare caching guide). Files in public/ keep their names across deploys,
# so they stay on the default revalidating header.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
