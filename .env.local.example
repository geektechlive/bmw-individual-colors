# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is gitignored.

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Admin — any strong random string; gates /admin and delete/dismiss actions,
# and also signs the HMAC edit tokens used by the /edit/[id] links (see src/lib/edit-token.ts)
ADMIN_TOKEN=your-admin-token

# For local Playwright runs, Cloudflare's published Turnstile test keys always pass
# without solving a challenge — do not use these in production:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cloudflare API — only needed for local observability scripts, not for the app itself
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# vBulletin forum posting — used by scripts/post-to-bimmerpost.ts (see README.md)
BIMMERPOST_USERNAME=your-forum-username
BIMMERPOST_PASSWORD=your-forum-password
