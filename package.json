{
  "name": "bmw-individual-colors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "node node_modules/.bin/playwright test",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test --test-timeout=10000 tests/unit/*.test.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:unit && npm run build:cf"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/supabase-js": "^2.119.0",
    "country-state-city": "^3.2.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "d3-color": "^3.1.0"
  }
}
